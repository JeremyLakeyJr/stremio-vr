# ==============================================================================
# Movie Night VR (Media-VR) Configuration
# ==============================================================================

# --- Server & Network ---
PORT=3000
HOST=0.0.0.0
SOURCE_URL=https://github.com/oOflyeyesOo/Media-VR

# Allow private network IP addresses for local LAN servers (e.g. 192.168.x.x, 10.x.x.x)
ALLOW_PRIVATE_NETWORKS=true

# Explicit host allowlist for SSRF protection (comma-separated host:port entries)
# Upstream servers listed below are automatically appended to this allowlist
MEDIA_ALLOWED_HOSTS=stremio:11470

# --- Cloudflare Tunnel Configuration ---
# 1. Free Quick Tunnel (Default):
# Leave TUNNEL_TOKEN empty. A temporary *.trycloudflare.com URL will be generated automatically.
#
# 2. Paid / Named Cloudflare Tunnel (Zero Trust / Argo):
# Paste your tunnel token from Cloudflare Zero Trust (Networks -> Tunnels) below:
TUNNEL_TOKEN=
# Your custom domain pointing to this tunnel (e.g. https://vr.yourdomain.com):
TUNNEL_URL=

# --- Transcoder & GPU Hardware Acceleration ---
# Max output resolution for room transcoding: 720, 1080, 1440, or 2160 (4K)
MEDIA_MAX_HEIGHT=1080
# Max output framerate: 30 or 60
MEDIA_MAX_FPS=60
# Video bitrate for transcoded streams (e.g. 8M, 15M, 25M)
MEDIA_VIDEO_BITRATE=15M
# Max transcoded HLS cache size in bytes (Default: 24 GiB for HD/4K)
MEDIA_MAX_BYTES=25769803776
# Maximum concurrent transcoding jobs
MEDIA_MAX_JOBS=4
# Set to 'true' to disable smart -c:v copy direct remuxing (forces all streams through transcode)
MEDIA_DISABLE_REMUX=false

# Optional GPU device override for Linux VAAPI / QSV (e.g. /dev/dri/renderD128)
VAAPI_DEVICE=/dev/dri/renderD128

# --- Media Providers (Auto-allowed in MEDIA_ALLOWED_HOSTS) ---
# Stremio internal streaming server:
STREAMING_SERVICE_URL=http://stremio:11470

# Jellyfin / Remux server URL (e.g. http://192.168.1.100:8096 or https://jellyfin.yourdomain.com)
JELLYFIN_URL=

# MediaStorm streaming instance URL:
MEDIASTORM_URL=

# Silo self-hosted server URL:
SILO_URL=

# --- WebRTC & Audio (VoIP / In-World Chat) ---
ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"}]
TURN_URLS=
TURN_SECRET=
