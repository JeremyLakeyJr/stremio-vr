{
  "manifest_version": 3,
  "name": "Movie Night room capture",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "tabCapture",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
